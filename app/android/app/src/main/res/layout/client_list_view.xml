<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ClientListFragment"
    android:background="@android:color/background_light">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_client"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- saveEnabled=false : StickyListHeadersListView.onSaveInstanceState() throws
             "Handling non empty state of parent class is not implemented" as soon as the view
             holds any state of its own, which happens once autofill has assigned it an id (the
             login dialog opens a session on this window). Nothing to lose : the list is reloaded
             from the server on every onViewCreated. -->
        <se.emilsjolander.stickylistheaders.StickyListHeadersListView
            android:id="@+id/client_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:text="@string/no_client_to_display"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>