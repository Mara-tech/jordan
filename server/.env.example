REDIS_HOST=your-redis-host.example.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ── Admin authentication (/jordan/admin/*) ───────────────────────────────────
# At least one of the two must be set, otherwise every admin request is refused.

# Named operator accounts, as a JSON array. Generate an entry with:
#   python admin_identity.py <login> <password> [viewer|operator|admin]
# An unusable declaration (malformed JSON, an account without a passwordHash, an
# unknown role, a login declared twice) stops the server at startup rather than
# dropping that account silently. An empty array is valid: no named operator,
# the shared token below then stands alone.
JORDAN_ADMIN_USERS=[{"login": "alice", "passwordHash": "pbkdf2:sha256:Enc0d3dP@$5w0rD", "role": "viewer"}]

# Shared bootstrap token: full permissions, no named operator. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JORDAN_ADMIN_TOKEN=

# Lifetime in seconds of a token returned by /jordan/admin/login (default 43200 = 12 h)
#JORDAN_ADMIN_SESSION_TTL=43200

# ── Passive client registration (/jordan/client/register) ────────────────────
# Registration is open when the key is unset: anyone reaching the server can
# create a client. Set it on a public deployment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#JORDAN_REGISTRATION_KEY=
#
# A JSON object names several keys at once, which is how one is replaced without
# updating every client at the same minute: publish the new key beside the old,
# move the clients over, then drop the retired entry once the logs stop naming
# it. Each accepted registration logs the name of the key used, never the key.
# A value set but unusable stops the server at startup rather than closing
# registration silently.
#JORDAN_REGISTRATION_KEY={"retiring":"<old>","current":"<new>"}

# Registration attempts allowed per caller address and per window, valid or not
# (0 disables the check)
#JORDAN_REGISTRATION_RATE_LIMIT=20
#JORDAN_REGISTRATION_RATE_WINDOW=60
